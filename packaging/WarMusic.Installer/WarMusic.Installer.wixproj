<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.1</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\staging\installed</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
    <OutputName>WarMusic-$(ProductVersion)-win-x64-setup</OutputName>
    <DebugType>none</DebugType>
    <AcceptEula Condition="'$(WixEulaId)' != ''">$(WixEulaId)</AcceptEula>
  </PropertyGroup>
</Project>
