<Window x:Class="WarMusic.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WarMusic overlay"
        Width="312" MinWidth="268" MaxWidth="460"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="Transparent" Foreground="#E6EBDC" FontFamily="Segoe UI" FontSize="13"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        AutomationProperties.Name="WarMusic overlay">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVis"/>
  <Style x:Key="HudButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Background" Value="#2A3426"/>
  </Style>
  <Style x:Key="HudQuiet" TargetType="Button" BasedOn="{StaticResource HudButton}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="#3A4534"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
 </Window.Resources>
 <Grid Margin="6">
  <Border CornerRadius="12" Background="#161C16" Opacity="{Binding OverlayOpacity}"/>
  <Border x:Name="Chrome" CornerRadius="12" BorderThickness="1" Padding="12,8,12,10">
   <Border.Style>
    <Style TargetType="Border">
     <Setter Property="BorderBrush" Value="#33402E"/>
     <Style.Triggers>
      <DataTrigger Binding="{Binding OverlayInteractive}" Value="True">
       <Setter Property="BorderBrush" Value="#AABA85"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </Border.Style>
   <StackPanel>
    <Border Height="16" Margin="0,0,0,6" Cursor="SizeAll" Background="Transparent"
            MouseLeftButtonDown="DragWindow" Visibility="{Binding OverlayInteractive, Converter={StaticResource BoolVis}}"
            AutomationProperties.Name="Move overlay">
     <TextBlock Text="Move" FontSize="10" Foreground="#8F9D80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <DockPanel Margin="0,0,0,8" LastChildFill="True">
     <Image DockPanel.Dock="Left" Source="Assets/WarMusic.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
     <Button DockPanel.Dock="Right" Content="{Binding OverlayLayoutGlyph}" Width="28" Padding="0,2" Margin="6,0,0,0" Style="{StaticResource HudQuiet}"
             Command="{Binding ToggleOverlayLayoutCommand}" ToolTip="Compact / expanded layout" AutomationProperties.Name="Toggle overlay layout"/>
     <Button x:Name="LockButton" DockPanel.Dock="Right" Content="{Binding OverlayLockLabel}" Command="{Binding OverlayInteractCommand}"
             Padding="7,2" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" Cursor="Hand"
             ToolTip="Lock or unlock overlay controls. This chip stays clickable in locked mode."
             AutomationProperties.Name="Lock or unlock overlay">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource HudQuiet}">
        <Setter Property="Background" Value="#2A3328"/>
        <Setter Property="Foreground" Value="#8F9D80"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding OverlayInteractive}" Value="True">
          <Setter Property="Background" Value="#3E4C32"/>
          <Setter Property="Foreground" Value="#B8CE79"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
     </Button>
     <TextBlock Text="WARMUSIC" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="#D5DFC8"/>
    </DockPanel>
    <TextBlock Text="{Binding OverlayHeadline}" FontSize="15" FontWeight="SemiBold"
               TextTrimming="CharacterEllipsis" ToolTip="{Binding OverlayHeadline}"/>
    <TextBlock Text="{Binding OverlayKind}" FontSize="11" Foreground="#939E8D" Margin="0,2,0,6"/>
    <DockPanel Margin="0,0,0,8">
     <Border DockPanel.Dock="Right" Background="#39462F" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
             Visibility="{Binding OverlayDucking, Converter={StaticResource BoolVis}}">
      <TextBlock Text="Ducked" FontSize="10" Foreground="#B8CE79"/>
     </Border>
     <TextBlock Text="{Binding OverlayMusic}" FontSize="11" Foreground="#C5CEBC" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <TextBlock Text="{Binding OverlayCable}" FontSize="11" Foreground="#AABA85" Margin="0,0,0,8"/>
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" Text="{Binding GameMusicLabel}" Foreground="#AABA85" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
     <TextBlock Text="Music to game" FontSize="11" Foreground="#939E8D" VerticalAlignment="Center"/>
    </DockPanel>
    <Slider Minimum="0" Maximum="100" Value="{Binding GameMusicVolume}" Margin="0,4,0,6"
            Height="16" AutomationProperties.Name="Game music volume percent"/>
    <ProgressBar Value="{Binding SentMusicMeter,Mode=OneWay}" Foreground="{Binding MusicLevelColor}" Height="3" Margin="0,0,0,2"/>
    <StackPanel Visibility="{Binding OverlayExpanded, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
     <Border BorderBrush="#2C3529" BorderThickness="0,1,0,0" Padding="0,10,0,0">
      <StackPanel>
       <TextBlock Text="{Binding OverlayApplication}" FontSize="11" Foreground="#939E8D" TextTrimming="CharacterEllipsis"
                  ToolTip="Application capture only. Local buttons do not control this player."/>
       <WrapPanel Margin="0,10,0,0">
        <Button Content="{Binding MusicButtonLabel}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanTransmitControl}"
                Style="{StaticResource HudButton}" Background="#566737" Foreground="#F2F5EA"/>
        <Button Content="Cut music" Command="{Binding PanicCommand}" Style="{StaticResource HudQuiet}" Foreground="#D8A69A"
                ToolTip="Immediate panic cut. Voice stays available."/>
       </WrapPanel>
       <WrapPanel Margin="0,6,0,0">
        <Button Content="{Binding OverlayPlayLabel}" Command="{Binding TransportPauseCommand}" IsEnabled="{Binding CanTogglePlayback}"
                Style="{StaticResource HudQuiet}" ToolTip="Pause or resume the current local sound. This does not control application capture."/>
        <Button Content="Next local" Command="{Binding NextCommand}" IsEnabled="{Binding CanPlayNext}" Style="{StaticResource HudQuiet}"
                ToolTip="Play the next queued local sound."/>
       </WrapPanel>
       <TextBlock Text="Confirm the cable in your game's mic test." FontSize="10" Foreground="#7E8A74" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <DockPanel Margin="0,8,0,0" Visibility="{Binding OverlayInteractive, Converter={StaticResource BoolVis}}">
     <Border DockPanel.Dock="Right" Width="14" Height="14" Cursor="SizeNWSE" Background="Transparent"
             MouseLeftButtonDown="ResizePressed" MouseMove="ResizeMoved" MouseLeftButtonUp="ResizeReleased"
             AutomationProperties.Name="Resize overlay">
      <Path Data="M 10 0 L 10 10 L 0 10" Stroke="#8F9D80" StrokeThickness="1.5" Stretch="Fill" Margin="1"/>
     </Border>
     <TextBlock Text="{Binding OverlayHint}" FontSize="10" Foreground="#7E8A74" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </DockPanel>
   </StackPanel>
  </Border>
 </Grid>
</Window>
